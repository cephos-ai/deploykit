        "text": "={{ $json.action === 'created' ? ':new: Filed *' + $json.identifier + '* - ' + $json.title + '\\n' + $json.issue_url : ':heavy_plus_sign: +1 on *' + $json.identifier + '* (same root cause) - ' + $json.title + '\\n' + $json.issue_url }}",
        "otherOptions": {
          "thread_ts": {
            "replyValues": {
              "thread_ts": "={{ $('Slack Trigger').first().json.thread_ts || $('Slack Trigger').first().json.ts }}"
            }
          }
