          "waitForSubWorkflow": true
        }
      },
      "id": "22222222-2222-4222-8222-222222222205",
      "name": "Run Issue Triage",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [880, 0]
